{$YAC_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        -Server
    }
    request_body {
        max_size 1MB
    }
    @releaseMetadata path /downloads/release.json
    header @releaseMetadata Cache-Control "no-cache"
    redir /downloads/yet-another-cat-0.13.3.apk /downloads/yet-another-cat-0.13.4.apk 302
    handle_path /downloads/* {
        root * /srv/downloads
        file_server
    }
    @manifest {
        method GET HEAD
        path_regexp manifest ^/manifests/(deployments/[1-9A-HJ-NP-Za-km-z]{32,44}/)?cycles/[1-9A-HJ-NP-Za-km-z]{32,44}/[0-9]+/manifest\.json$
    }
    handle @manifest {
        uri replace /manifests/ /yac-manifests/
        reverse_proxy minio:9000 {
            header_up -Authorization
            header_down Cache-Control "public, max-age=31536000, immutable"
        }
    }
    handle /manifests/* {
        respond 404
    }
    @backend path /api/* /public/*
    handle @backend {
        reverse_proxy api:8080 {
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 5s
                response_header_timeout 190s
            }
        }
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 3
        }
    }
}
