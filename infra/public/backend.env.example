YAC_RPC_PRIMARY=https://YOUR_PRIVATE_DEVNET_RPC
YAC_RPC_VERIFY=https://YOUR_VERIFICATION_DEVNET_RPC
YAC_VERIFY_TIMEOUT_SECONDS=900
YAC_CATCHUP_DELAY_SECONDS=5
# Disable automatic signing and background verification for controlled CLI recovery.
YAC_RECOVERY_MODE=false
YAC_DEPLOYMENT_FILE=/run/yac/deployment.json
YAC_CLUSTER=devnet
YAC_INDEXER_INTERVAL_MS=15000
YAC_MAX_INDEXER_LAG_SLOTS=250
DATABASE_PROVIDER=postgres
DATABASE_CONNECTION_STRING=Host=postgres;Database=yac;Username=yac;Password=REPLACE;Maximum Pool Size=12
YAC_MANIFEST_PROVIDER=s3
YAC_S3_ENDPOINT=http://minio:9000
YAC_S3_BUCKET=yac-manifests
YAC_S3_ACCESS_KEY=yac-publisher
YAC_S3_SECRET_KEY=REPLACE
YAC_MANIFEST_PUBLIC_BASE_URL=https://YOUR_DOMAIN/manifests
YAC_SETTLEMENT_ENABLED=true
YAC_PUBLISHER_ENABLED=false
YAC_PUBLISHER_KEY=/run/yac/publisher.json
YAC_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
