{
  "expo": {
    "name": "Yet Another Market Cat 💩",
    "slug": "yet-another-cat",
    "version": "0.13.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.yetanothercat.app",
      "versionCode": 27,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/yamc/front-closed.png",
        "backgroundColor": "#141910"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/with-release.cjs",
      "./plugins/with-animated-webp.cjs",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "yet-another-cat",
    "icon": "./assets/yamc/front-closed.png"
  }
}
